doctype html
html(lang="en")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        

        // Bootstrap CSS
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        )

        // Font Awesome
        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        )
        link(rel="stylesheet" href="css/style.css")

    body
        // Navbar
        nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.fixed-top
            .container
                a.navbar-brand(href="/") Shopping

                ul.navbar-nav
                    li.nav-item
                        a.nav-link(href="/login") Login

                    li.nav-item
                        a.nav-link(href="/register") Register

                    li.nav-item
                        a.nav-link(href="/") Home

        // Main Content
        .container.pt-100
            .row
                // Categories
                .col-lg-3.mb-4
                    .list-group
                        a.list-group-item.list-group-item-action(href="#") Category 1
                        a.list-group-item.list-group-item-action(href="#") Category 2
                        a.list-group-item.list-group-item-action(href="#") Category 3

                // Slider and Products
                .col-lg-9
                    // Slider
                    #mySlider.carousel.slide(data-bs-ride="carousel")
                        // Slider Indicators
                        .carousel-indicators
                            button.active(
                                type="button"
                                data-bs-target="#mySlider"
                                data-bs-slide-to="0"
                                aria-current="true"
                                aria-label="Slide 1"
                            )
                            button(
                                type="button"
                                data-bs-target="#mySlider"
                                data-bs-slide-to="1"
                                aria-label="Slide 2"
                            )
                            button(
                                type="button"
                                data-bs-target="#mySlider"
                                data-bs-slide-to="2"
                                aria-label="Slide 3"
                            )
                            button(
                                type="button"
                                data-bs-target="#mySlider"
                                data-bs-slide-to="3"
                                aria-label="Slide 4"
                            )
                            button(
                                type="button"
                                data-bs-target="#mySlider"
                                data-bs-slide-to="4"
                                aria-label="Slide 5"
                            )

                        // Carousel Images
                        .carousel-inner
                            .carousel-item.active
                                img.d-block.w-100(
                                    src="https://placehold.co/900x350?text=Slide+1"
                                    alt="Slide 1"
                                )
                            .carousel-item
                                img.d-block.w-100(
                                    src="https://placehold.co/900x350?text=Slide+2"
                                    alt="Slide 2"
                                )
                            .carousel-item
                                img.d-block.w-100(
                                    src="https://placehold.co/900x350?text=Slide+3"
                                    alt="Slide 3"
                                )
                            .carousel-item
                                img.d-block.w-100(
                                    src="https://placehold.co/900x350?text=Slide+4"
                                    alt="Slide 4"
                                )
                            .carousel-item
                                img.d-block.w-100(
                                    src="https://placehold.co/900x350?text=Slide+5"
                                    alt="Slide 5"
                                )

                        // Previous Button
                        button.carousel-control-prev(
                            type="button"
                            data-bs-target="#mySlider"
                            data-bs-slide="prev"
                        )
                            span.carousel-control-prev-icon(aria-hidden="true")
                            span.visually-hidden Previous

                        // Next Button
                        button.carousel-control-next(
                            type="button"
                            data-bs-target="#mySlider"
                            data-bs-slide="next"
                        )
                            span.carousel-control-next-icon(aria-hidden="true")
                            span.visually-hidden Next

                    // Product Cards
                    .row.mt-3
                        each product in products
                            .col-md-4.mb-4
                                .card.h-100
                                    img.card-img-top(src=product.image )

                                    .card-body
                                        h5.card-title
                                            a.text-decoration-none(href="#") #{product.name}

                                        p.card-text #{product.description}

                                    .card-footer.d-flex.justify-content-between.align-items-center
                                        small.text-muted #{product.price}
                                        a.btn.btn-secondary.btn-sm(href="#")
                                            i.fa-solid.fa-angles-right

                // End Slider and Products

        // Bootstrap JavaScript
        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"
        )