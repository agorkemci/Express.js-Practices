doctype html
html(lang="en")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title #{title}

        // Bootstrap CSS
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        )

        // Font Awesome
        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        )
        link(rel="stylesheet" href="css/style.css")
        block styles

    body
        // Navbar
        nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.fixed-top
            .container
                a.navbar-brand(href="/") Shopping

                ul.navbar-nav
                    li.nav-item
                        a.nav-link(href="/login") Login

                    li.nav-item
                        a.nav-link(href="/register") Register

                    li.nav-item
                        a.nav-link(href="/") Home

        // Main Content
        .container.pt-100
            .row
                // Categories
                .col-lg-3.mb-4
                    .list-group
                        a.list-group-item.list-group-item-action(href="#") Category 1
                        a.list-group-item.list-group-item-action(href="#") Category 2
                        a.list-group-item.list-group-item-action(href="#") Category 3

                // Slider and Products
                .col-lg-9
                    block content
                    

        // Bootstrap JavaScript
        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"
        )